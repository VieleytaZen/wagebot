# Groq API Key (wajib diisi) — dapatkan di console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Groq (opsional, default: llama-3.3-70b-versatile)
# Pilihan: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# Nama bot di log (opsional)
# BOT_NAME=Kodi - Jus Kode

# Batas maksimal pesan yang disimpan per user (opsional, default: 50)
# MAX_HISTORY=50

# Cooldown antar pesan dari user yang sama dalam ms (opsional, default: 1500)
# COOLDOWN_MS=1500
