# Groq API Key (wajib diisi) — dapatkan di console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Groq (opsional, default: llama-3.3-70b-versatile)
# Pilihan: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# Nama bot di log (opsional)
# BOT_NAME=Kodi - Jus Kode

# WhatsApp ID Role-Based Access Control (RBAC)
# Salin ID dari log bot: misal 83227876290608@lid atau 628123456789@c.us
# Bisa diisi lebih dari satu nomor, pisahkan dengan koma: 83xx@lid,628xx@c.us

# Owner & Manajer (Akses Penuh)
# OWNER_IDS=83227876290608@lid
# MANAGER_IDS=83227876290608@lid

# Kasir & Moderator (Akses Terbatas - hanya on/off stok)
# KASIR_IDS=
# MODERATOR_IDS=

# Batas maksimal pesan yang disimpan per user (opsional, default: 50)
# MAX_HISTORY=50

# Cooldown antar pesan dari user yang sama dalam ms (opsional, default: 1500)
# COOLDOWN_MS=1500
